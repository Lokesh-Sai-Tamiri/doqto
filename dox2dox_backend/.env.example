# Environment: local | staging | production
ENVIRONMENT=local

# Database
DATABASE_URL=postgresql+asyncpg://dox2dox:dox2dox@localhost:5432/dox2dox
REDIS_URL=redis://localhost:6379/0

# AWS (local uses fakes, see app.services.fakes)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=dox2dox-files-local
S3_TRANSCRIPT_BUCKET=dox2dox-transcripts-local

# Security
JWT_SECRET=change-me-in-prod-256-bit-random
MESSAGE_ENCRYPTION_KEY=change-me-base64-32-bytes-from-kms

# App
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Bootstrap
SUPER_ADMIN_PHONE=+15555550100
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_NPI=0000000001
# Used by the Next.js admin panel login. Any strong password for local dev.
SUPER_ADMIN_EMAIL=admin@dox2dox.app
SUPER_ADMIN_PASSWORD=change-me-now
